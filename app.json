{
    "expo": {
        "name": "EduNexus",
        "slug": "EduNexus",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "myapp",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.asifahammednishst.EduNexus"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "package": "com.asifahammednishst.EduNexus",
            "permissions": [
                "USE_BIOMETRIC",
                "USE_FINGERPRINT",
                "READ_CALENDAR",
                "WRITE_CALENDAR"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "splash": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "cover",
            "backgroundColor": "#ffffff"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#ffffff",
                    "image": "./assets/images/splash-icon.png",
                    "resizeMode": "cover"
                }
            ],
            "expo-font",
            [
                "expo-video",
                {
                    "supportsBackgroundPlayback": true,
                    "supportsPictureInPicture": true
                }
            ],
            "expo-secure-store",
            "@react-native-community/datetimepicker",
            [
                "@stripe/stripe-react-native",
                {
                    "merchantIdentifier": "merchant.com.asifahammednishst.EduNexus",
                    "enableApplePay": true
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "BACKEND_API": "http://192.168.0.109:8000/api",
            "API_BASE_URL": "http://192.168.0.109:8000",
            "router": {
                "origin": false
            },
            "eas": {
                "projectId": "9a083fc1-08ad-45de-ac3b-d932a2aafde5"
            }
        }
    }
}
